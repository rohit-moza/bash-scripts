#!/usr/bin/env bash
#
# gnb - git new branch
# Create and switch to a new branch named "<type>/<name>".
#
set -euo pipefail

read -rp "Branch type (feature/bugfix/hotfix/chore): " branch_type
read -rp "Branch name: " branch_name

# Trim surrounding whitespace.
branch_type="$(printf '%s' "${branch_type}" | xargs || true)"
branch_name="$(printf '%s' "${branch_name}" | xargs || true)"

if [[ -z "${branch_type}" || -z "${branch_name}" ]]; then
  echo "gnb: branch type and name are both required" >&2
  exit 1
fi

# Normalise the name: spaces -> hyphens.
branch_name="${branch_name// /-}"

branch="${branch_type}/${branch_name}"
echo "Creating branch: ${branch}"
git checkout -b "${branch}"
